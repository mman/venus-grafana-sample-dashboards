      "panel-15": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "datasource-influxdb"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "SELECT\n  last(\"voltage\")     AS \"Volt\",\n  last(\"current\")     AS \"Curr\",\n  last(\"temperature\") AS \"Tempr\",\n  last(\"base_state\")  AS \"Base State\",\n  last(\"volt_state\")  AS \"Volt. State\",\n  last(\"curr_state\")  AS \"Curr. State\",\n  last(\"temp_state\")  AS \"Temp. State\",\n  last(\"soc\")         AS \"SOC\",\n  last(\"coulomb\")     AS \"Coulomb\",\n  last(\"balancing\")   AS \"BAL\"\nFROM \"pylontech/cell\"\nWHERE time \u003e now() - 10m\nGROUP BY \"cell_id\", \"battery_id\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "BAL": false,
                        "Base State": true,
                        "Curr. State": true,
                        "Temp. State": true,
                        "Time": true,
                        "Volt. State": true
                      },
                      "includeByName": {},
                      "indexByName": {},
                      "renameByName": {}
                    }
                  }
                }
              ]
            }
          },
